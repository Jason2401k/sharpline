# Copy to .env and fill in. With no keys the site runs on demo data.

# https://the-odds-api.com  (free tier: 500 credits/month)
ODDS_API_KEY=

# Props cost Odds API credits per game; cap how many games per sport fetch props.
PROPS_EVENT_LIMIT=6

# Injuries come from ESPN's public endpoints (no key). Set to 0 to force demo injuries.
LIVE_INJURIES=1

# Show made-up sample games/props/injuries for testing the UI (never use in production).
SHOW_DEMO=0

# Public betting splits from SportsBettingDime (on by default; 0 turns it off).
LIVE_SBD=1

# KenPom ratings CSV you export from kenpom.com (default: data/kenpom.csv).
KENPOM_CSV=

PORT=3000
